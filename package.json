{
  "name": "defi-risk-radar-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build && node scripts/viewer-server.mjs",
    "inspect": "npm run build && node scripts/inspect.mjs",
    "check:providers": "npm run build && node scripts/check-providers.mjs",
    "build": "tsc -p tsconfig.json",
    "demo": "npm run build && node scripts/demo.mjs",
    "test": "npm run build && node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "replay": "npm run build && node scripts/replay.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:automatic": "npm run build && node scripts/browser-automatic.mjs",
    "build:contracts": "node scripts/compile-contract.mjs",
    "data:history": "npm run build && node scripts/download-history.mjs",
    "backtest": "npm run build && node scripts/backtest.mjs",
    "automation": "npm run build && node scripts/automation.mjs",
    "test:fork": "npm run build && npm run build:contracts && node scripts/fork-migration.mjs",
    "propose": "npm run build && node scripts/propose.mjs"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "^1.7.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "solc": "^0.8.37",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "viem": "^2.57.4",
    "zod": "^4.6.5"
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
